{
  "dashboard": {
    "id": null,
    "title": "ShopEase Monitoring",
    "panels": [
      {
        "type": "graph",
        "title": "Request Count",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum by (method, endpoint) (app_requests_total)",
            "legendFormat": "{{method}} {{endpoint}}",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "type": "heatmap",
        "title": "Request Latency (seconds)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(app_request_latency_seconds_bucket[5m])) by (le, method, endpoint))",
            "legendFormat": "95th {{method}} {{endpoint}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(app_request_latency_seconds_bucket[5m])) by (le, method, endpoint))",
            "legendFormat": "99th {{method}} {{endpoint}}",
            "refId": "C"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      }
    ],
    "schemaVersion": 30,
    "version": 1,
    "refresh": "5s"
  },
  "overwrite": true
}